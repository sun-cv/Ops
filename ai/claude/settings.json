{
  "model": "opus",
  "effortLevel": "xhigh",
  "theme": "dark-ansi",
  "permissions": {
    "allow": [
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Get-ItemProperty *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Resolve-Path *)",
      "PowerShell(Get-Location *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Select-String *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Where-Object *)",
      "PowerShell(ForEach-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Compare-Object *)",
      "PowerShell(Format-Table *)",
      "PowerShell(Format-List *)",
      "PowerShell(Out-String *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git remote *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git rev-parse *)"
    ],
    "ask": [
      "Bash(rm *)",
      "PowerShell(Remove-Item *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(git reset *)",
      "PowerShell(git reset *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(git filter-repo *)",
      "PowerShell(git filter-repo *)",
      "Bash(git cherry-pick *)",
      "PowerShell(git cherry-pick *)",
      "Bash(git revert *)",
      "PowerShell(git revert *)",
      "Read(**/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  }
}
